# Public site URL – used for canonical, Open Graph, sitemap and structured data
VITE_SITE_URL=https://www.example.com

# Backend base URL. Leave empty when the API is served from the same domain (/api).
VITE_API_URL=

# Dev server proxy target for /api (local backend)
VITE_DEV_API_PROXY=http://localhost:5050

# Optional public contact details. Leave empty until confirmed – the site then
# points visitors to the Request a Demo form instead of showing placeholders.
VITE_CONTACT_EMAIL=
VITE_CONTACT_PHONE=
