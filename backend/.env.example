NODE_ENV=development
PORT=5050

# MongoDB (local or Atlas). Collection used: "enquiries"
MONGO_URI=mongodb://127.0.0.1:27017/docvise_microsite

# Comma-separated list of front-end origins allowed to call the API
ALLOWED_ORIGINS=http://localhost:5173

# Set to 1 when running behind one reverse proxy / load balancer (Nginx, Render, Railway…)
TRUST_PROXY=0

# Public enquiry rate limit (per IP)
ENQUIRY_RATE_WINDOW_MINUTES=15
ENQUIRY_RATE_MAX=5

# ---- Admin API (enquiry management) ----
# At least 32 random characters. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
ADMIN_EMAIL=
# Generate with: npm run hash-password -- "your-strong-password"
ADMIN_PASSWORD_HASH=

# ---- Email notification for new demo requests ----
# DocTalk-compatible EMAIL_* variables. Hostinger SMTP defaults:
EMAIL_HOST=smtp.hostinger.com
EMAIL_PORT=465
EMAIL_SECURE=true
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=
# Demo requests are sent here by default:
NOTIFY_TO=info@digilateral.com

# Legacy SMTP_* aliases are supported too:
# SMTP_HOST=
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=
# SMTP_PASS=
# NOTIFY_FROM=
