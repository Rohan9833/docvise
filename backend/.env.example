NODE_ENV=development
PORT=5050

# Comma-separated frontend origins allowed to call the API
ALLOWED_ORIGINS=http://localhost:5173

# Set to 1 when running behind one reverse proxy / load balancer
TRUST_PROXY=0

# Public enquiry rate limit (per IP)
ENQUIRY_RATE_WINDOW_MINUTES=15
ENQUIRY_RATE_MAX=5

# Email delivery for demo requests (Hostinger SMTP)
EMAIL_HOST=smtp.hostinger.com
EMAIL_PORT=465
EMAIL_SECURE=true
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=
NOTIFY_TO=info@digilateral.com

# Legacy SMTP_* aliases are also supported
# SMTP_HOST=
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=
# SMTP_PASS=
# NOTIFY_FROM=
